# Copy this file to .env and fill in your own values.
# Never commit .env. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Separate key for encrypting TOTP secrets at rest (Fernet key). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Optional. Default: backend/cloudpay_shield.db (absolute path, works from any folder).
# DATABASE_URL=sqlite:///C:/path/to/cloudpay_shield.db
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Managers must have MFA enabled and a verified MFA session to approve or reject.
REQUIRE_MFA_FOR_DECISIONS=true
# Risk policy (all optional - defaults shown)
RISK_INCREASE_THRESHOLD_PCT=25
RISK_VERY_LARGE_INCREASE_PCT=50
RISK_DECREASE_THRESHOLD_PCT=10
RISK_SEVERE_DECREASE_PCT=30
RISK_MIN_HISTORY_SAMPLES=5
PAYROLL_MINIMUM_SALARY=37000
PAYROLL_MAXIMUM_SALARY=5000000
